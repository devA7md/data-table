{
  "name": "@heroes/data-table",
  "version": "1.0.0",
  "description": "Generic, reusable React data table built on @tanstack/react-table and shadcn/ui conventions.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build:demo": "vite build --config playground/vite.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "registry:validate": "npx shadcn@latest registry validate ./registry.json"
  },
  "peerDependencies": {
    "@tanstack/react-table": ">=8.21.2 < 9",
    "lucide-react": ">=1.31.0 < 2",
    "react": ">=19.2.0 < 20",
    "react-dom": ">=19.2.0 < 20"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
